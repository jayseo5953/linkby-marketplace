# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
# .env itself is committed on purpose (T-21); every sibling stays ignored, so a
# later .env.production holding real credentials cannot be staged by accident.
.env.*
!.env

