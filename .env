# Committed on purpose, so the stack runs from a clone with nothing to fill in by hand.
# Local-only container credentials; this exercise is never deployed. A real deployment
# would keep .env out of the repo — every sibling (.env.production, .env.local) is ignored.
#
# Only values that differ between environments live here. Ports and NODE_ENV are fixed in
# docker-compose.yml, and DATABASE_URL is derived there from the POSTGRES_* values below.

# Postgres
POSTGRES_USER=linkby
POSTGRES_PASSWORD=linkby
POSTGRES_DB=linkby

# Object storage. Point S3_ENDPOINT at AWS and these become real S3 credentials.
S3_ENDPOINT=http://storage:9000
# The same bucket seen from the browser, which cannot resolve the `storage` container name.
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=linkby-images
S3_ACCESS_KEY=linkby
S3_SECRET_KEY=linkbysecret

# Auth. Committed like every other local credential here; rotating it invalidates every
# token already issued, so everyone signed in is logged out.
JWT_SECRET=d7ab4780348d36cb9945850f8e926d216e938ab5010790531742cb4a91291af6

# Where the browser reaches the API, and which origin the API trusts.
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
